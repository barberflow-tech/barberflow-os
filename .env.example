# Copia este archivo a .env (cp .env.example .env) y reemplaza los valores.
# .env NO se sube a git. Nunca pongas llaves reales en este archivo.

# Django
DJANGO_SECRET_KEY=change-me-generate-a-new-secret-key
DJANGO_DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Postgres local (Docker). El backend usa estas 3 variables; elige tu propia clave.
# Si cambias la clave despues de haber levantado Docker por primera vez,
# hay que recrear el volumen: docker compose down -v
POSTGRES_USER=barberadmin
POSTGRES_PASSWORD=Criss
POSTGRES_DB=barberflow_db

# Supabase Cloud / Staging (Asignar cuando conecten la BD en la nube)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
