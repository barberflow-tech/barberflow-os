# Copia este archivo a .env (cp .env.example .env) y reemplaza los valores.
# .env NO se sube a git. Nunca pongas llaves reales en este archivo.

# Django
DJANGO_SECRET_KEY=change-me-generate-a-new-secret-key
DJANGO_DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base de datos local = stack local de Supabase (`supabase start`).
# Puerto 54322, usuario/clave/base por defecto de la CLI. El backend corre en
# Docker, por eso llega al host con host.docker.internal.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=54322
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Supabase LOCAL (Realtime). La URL es fija; la anon key la imprime
# `supabase status` (campo "anon key" / "Publishable"). Pegala aqui.
# Las llaves de la nube (Staging) NUNCA van en este archivo ni en tu .env:
# solo se configuran en Vercel/Render.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=pega-aqui-la-anon-key-de-supabase-status

# Supabase Storage: acceso exclusivo desde el backend.
# No compartir esta llave con el frontend ni subirla a Git.
SUPABASE_STORAGE_URL=http://host.docker.internal:54321
SUPABASE_STORAGE_BUCKET=barber-portfolios
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key
SUPABASE_SECRET_KEY=pega-aqui-la-secret-key