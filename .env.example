# Copia este archivo a .env (cp .env.example .env) y reemplaza los valores.
# .env NO se sube a git. Nunca pongas llaves reales en este archivo.

# Django
DJANGO_SECRET_KEY=change-me-generate-a-new-secret-key
DJANGO_DEBUG=True
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Autenticacion (HU-06). Todas tienen valor por defecto; en local no hace falta cambiarlas.
# Hosts desde los que se sirve la API, separados por coma. Con DJANGO_DEBUG=True no hace
# falta; en Staging/produccion es obligatorio (si queda vacio, toda peticion da 400).
DJANGO_ALLOWED_HOSTS=
# Duracion del access token (minutos) y del refresh token (dias).
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Cookie del refresh token. Por defecto es Secure salvo con DJANGO_DEBUG=True.
# SameSite: Lax en local; None si frontend y API estan en sitios distintos
# (Vercel + Render), y entonces AUTH_COOKIE_SECURE debe ser True (exige HTTPS).
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# Base de datos local = stack local de Supabase (`supabase start`).
# Puerto 54322, usuario/clave/base por defecto de la CLI. El backend corre en
# Docker, por eso llega al host con host.docker.internal.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=54322
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Supabase LOCAL (Realtime). La URL es fija; la anon key la imprime
# `supabase status` (campo "anon key" / "Publishable"). Pegala aqui.
# Las llaves de la nube (Staging) NUNCA van en este archivo ni en tu .env:
# solo se configuran en Vercel/Render.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=pega-aqui-la-anon-key-de-supabase-status
