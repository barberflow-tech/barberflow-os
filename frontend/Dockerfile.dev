FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY . .

EXPOSE 5173

# Al arrancar se sincroniza node_modules con package.json: tras un `git pull`
# que cambie dependencias basta con `docker compose up`, sin npm install manual.
CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0"]
